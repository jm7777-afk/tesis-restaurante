# Base de Datos (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/donde_david_db

# Seguridad
SECRET_KEY=donde_david_super_secret_jwt_key_2026_tesis_restaurante_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuración
ENV=production
DEBUG=False
API_VERSION=v1

# URLs
FRONTEND_URL=https://donde-david.com
BACKEND_URL=https://api.donde-david.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS
CORS_ORIGINS=https://donde-david.com,https://www.donde-david.com,https://donde-david.onrender.com,https://donde-david-backend.onrender.com

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@donde-david.com
SMTP_PASSWORD=tu_contraseña

# Tasa de Cambio
TASA_CAMBIO_DEFAULT=42.50
IVA_PORCENTAJE=16.00
