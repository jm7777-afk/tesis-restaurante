# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - DONDE DAVID MANAGEMENT SYSTEM
# ==============================================================================

# Entorno: development | testing | production
ENVIRONMENT=production

# Nombre del Sistema y Versión
PROJECT_NAME="Donde David Restaurant Management System"
VERSION=2.0.0

# Secreto JWT para firmas de token (REQUERIDO CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=donde_david_super_secret_jwt_key_2026_tesis_restaurante

# Expiración de Token JWT en Minutos (1440 min = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos (SQLite local / MySQL InfinityFree / PostgreSQL Render)
# Ejemplo SQLite Local: sqlite:///./restaurante.db
# Ejemplo MySQL InfinityFree: mysql+pymysql://if0_37123456:password@sql300.infinityfree.com/if0_37123456_restaurante
# Ejemplo PostgreSQL Render: postgresql://usuario:password@dpg-xxxx-a.render.com/restaurante_db
DATABASE_URL=sqlite:///./restaurante.db

# Orígenes Permitidos CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://tesis-restaurante.onrender.com
