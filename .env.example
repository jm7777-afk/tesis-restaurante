# ============================================================ #
# DONDE DAVID - PLANTILLA DE VARIABLES DE ENTORNO              #
# ============================================================ #

# Base de Datos (PostgreSQL en Producción / SQLite en Desarrollo Local)
# Ejemplo PostgreSQL: postgresql://postgres:password@localhost:5432/donde_david_db
# Ejemplo SQLite: sqlite:///./restaurante.db
DATABASE_URL=sqlite:///./restaurante.db

# Clave Secreta para Firma JWT (Generar una cadena aleatoria segura de 32+ caracteres)
SECRET_KEY=cambiar_esta_clave_secreta_jwt_en_produccion_2026

# Entorno de Ejecución ('development' | 'production')
ENVIRONMENT=development
DEBUG=true

# Algoritmo JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dominios Permitidos CORS (Separados por comas)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://adondedavid-com.onrender.com

# Puerto del Servidor (Asignado dinámicamente por Render/Docker)
PORT=8000
